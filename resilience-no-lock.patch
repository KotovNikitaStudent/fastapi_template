+"""Circuit Breaker: перестаём ходить в зависимость, которая уже сломана.
+
+Состояния:
+    CLOSED     — вызовы проходят, подряд идущие ошибки считаются;
+    OPEN       — вызовы сразу отклоняются (CircuitBreakerOpenError), в
+                 зависимость запросы не уходят, пока не пройдёт recovery_timeout;
+    HALF_OPEN  — пропускаем ограниченное число пробных вызовов: успех замыкает
+                 breaker, ошибка снова размыкает его.
+
+Реализация живёт в памяти процесса: у каждого воркера своё состояние.
+"""
+
+import asyncio
+import enum
+import logging
+import time
+from typing import Awaitable, Callable, TypeVar
+
+logger = logging.getLogger(__name__)
+
+T = TypeVar("T")
+
+
+class CircuitState(str, enum.Enum):
+    CLOSED = "closed"
+    OPEN = "open"
+    HALF_OPEN = "half_open"
+
+
+class CircuitBreakerOpenError(Exception):
+    """Breaker разомкнут, вызов зависимости не выполнялся."""
+
+
+class CircuitBreaker:
+    def __init__(
+        self,
+        name: str,
+        failure_threshold: int = 5,
+        recovery_timeout: float = 30.0,
+        half_open_max_calls: int = 1,
+        expected_exceptions: tuple[type[BaseException], ...] = (Exception,),
+        clock: Callable[[], float] = time.monotonic,
+    ) -> None:
+        self.name = name
+        self.failure_threshold = failure_threshold
+        self.recovery_timeout = recovery_timeout
+        self.half_open_max_calls = half_open_max_calls
+        self.expected_exceptions = expected_exceptions
+        self._clock = clock
+
+        self._state = CircuitState.CLOSED
+        self._failures = 0
+        self._opened_at = 0.0
+        self._half_open_in_flight = 0
+        self._lock = asyncio.Lock()
+
+    @property
+    def state(self) -> CircuitState:
+        """Текущее состояние (OPEN → HALF_OPEN по истечении recovery_timeout)."""
+        if (
+            self._state is CircuitState.OPEN
+            and self._clock() - self._opened_at >= self.recovery_timeout
+        ):
+            return CircuitState.HALF_OPEN
+        return self._state
+
+    async def _before_call(self) -> bool:
+        """Возвращает True, если вызов — пробный (half-open)."""
+        async with self._lock:
+            state = self.state
+            if state is CircuitState.OPEN:
+                raise CircuitBreakerOpenError(f"circuit '{self.name}' is open")
+            if state is CircuitState.HALF_OPEN:
+                if self._state is CircuitState.OPEN:
+                    self._transition(CircuitState.HALF_OPEN)
+                if self._half_open_in_flight >= self.half_open_max_calls:
+                    raise CircuitBreakerOpenError(
+                        f"circuit '{self.name}' is half-open, probe limit reached"
+                    )
+                self._half_open_in_flight += 1
+                return True
+            return False
+
+    async def _on_success(self, probe: bool) -> None:
+        async with self._lock:
+            if probe:
+                self._half_open_in_flight -= 1
+                if self._state is CircuitState.HALF_OPEN:
+                    self._transition(CircuitState.CLOSED)
+            self._failures = 0
+
+    async def _on_failure(self, probe: bool) -> None:
+        async with self._lock:
+            if probe:
+                self._half_open_in_flight -= 1
+                if self._state is CircuitState.HALF_OPEN:
+                    self._transition(CircuitState.OPEN)
+                return
+            self._failures += 1
+            if (
+                self._state is CircuitState.CLOSED
+                and self._failures >= self.failure_threshold
+            ):
+                self._transition(CircuitState.OPEN)
+
+    async def _on_cancel(self, probe: bool) -> None:
+        """Отмену (например, по дедлайну) не считаем ни успехом, ни ошибкой."""
+        if probe:
+            async with self._lock:
+                self._half_open_in_flight -= 1
+
+    def _transition(self, new_state: CircuitState) -> None:
+        logger.warning(
+            "circuit '%s': %s -> %s", self.name, self._state.value, new_state.value
+        )
+        self._state = new_state
+        if new_state is CircuitState.OPEN:
+            self._opened_at = self._clock()
+        elif new_state is CircuitState.CLOSED:
+            self._failures = 0
+        elif new_state is CircuitState.HALF_OPEN:
+            self._half_open_in_flight = 0
+
+    async def call(self, func: Callable[[], Awaitable[T]]) -> T:
+        probe = await self._before_call()
+        try:
+            result = await func()
+        except self.expected_exceptions:
+            await self._on_failure(probe)
+            raise
+        except BaseException:
+            await self._on_cancel(probe)
+            raise
+        await self._on_success(probe)
+        return result
diff --git a/app/resilience/deadline.py b/app/resilience/deadline.py
new file mode 100644
index 0000000..51ae81d
--- /dev/null
+++ b/app/resilience/deadline.py
@@ -0,0 +1,79 @@
+"""Deadline: абсолютный срок, к которому запрос обязан завершиться.
+
+В отличие от «таймаута на вызов», дедлайн один на весь запрос: каждый
+следующий шаг (повторные попытки, походы в зависимости) получает только
+остаток бюджета. Дедлайн хранится в ContextVar, поэтому доступен в любом месте
+цепочки вызовов без явной передачи параметров (deadline propagation).
+"""
+
+import asyncio
+import time
+from contextlib import asynccontextmanager
+from contextvars import ContextVar
+from dataclasses import dataclass
+from typing import AsyncIterator
+
+
+class DeadlineExceededError(Exception):
+    """Бюджет времени на запрос исчерпан."""
+
+
+@dataclass(frozen=True)
+class Deadline:
+    expires_at: float  # значение time.monotonic()
+
+    @classmethod
+    def after(cls, seconds: float) -> "Deadline":
+        return cls(expires_at=time.monotonic() + seconds)
+
+    def remaining(self) -> float:
+        return max(0.0, self.expires_at - time.monotonic())
+
+    @property
+    def expired(self) -> bool:
+        return self.remaining() <= 0.0
+
+    def narrow(self, seconds: float) -> "Deadline":
+        """Новый дедлайн не позже текущего: можно сузить, нельзя расширить."""
+        return Deadline(min(self.expires_at, time.monotonic() + seconds))
+
+
+_current: ContextVar[Deadline | None] = ContextVar("request_deadline", default=None)
+
+
+def current_deadline() -> Deadline | None:
+    return _current.get()
+
+
+def remaining_time(default: float | None = None) -> float | None:
+    """Остаток бюджета в секундах или default, если дедлайн не установлен."""
+    deadline = _current.get()
+    return deadline.remaining() if deadline is not None else default
+
+
+@asynccontextmanager
+async def deadline_scope(seconds: float) -> AsyncIterator[Deadline]:
+    """Устанавливает дедлайн и отменяет работу внутри блока по его истечении.
+
+    Вложенный scope может только ужесточить внешний дедлайн.
+    Наружу выбрасывается DeadlineExceededError.
+    """
+    parent = _current.get()
+    deadline = parent.narrow(seconds) if parent else Deadline.after(seconds)
+    token = _current.set(deadline)
+    try:
+        if deadline.expired:
+            raise DeadlineExceededError("deadline already exceeded")
+        timeout_cm = asyncio.timeout_at(
+            asyncio.get_running_loop().time() + deadline.remaining()
+        )
+        try:
+            async with timeout_cm:
+                yield deadline
+        except TimeoutError as exc:
+            # Чужой TimeoutError (например, сокета) не маскируем под дедлайн.
+            if not timeout_cm.expired():
+                raise
+            raise DeadlineExceededError("deadline exceeded") from exc
+    finally:
+        _current.reset(token)
diff --git a/app/resilience/rate_limiter.py b/app/resilience/rate_limiter.py
new file mode 100644
index 0000000..6afa141
--- /dev/null
+++ b/app/resilience/rate_limiter.py
@@ -0,0 +1,171 @@
+"""Rate Limiter: не даём системе захлебнуться потоком запросов.
+
+Счётчики лежат в Redis, поэтому лимит общий для всех воркеров и инстансов.
+Каждая проверка выполняется одним Lua-скриптом, то есть атомарно: нет гонок
+между чтением и записью состояния.
+
+Два алгоритма:
+* TokenBucketRateLimiter (по умолчанию) — ведро ёмкостью `capacity`, токены
+  пополняются со скоростью `refill_per_second`; допускает короткие всплески,
+  но держит среднюю скорость.
+* FixedWindowRateLimiter — не более `limit` запросов за окно `window_seconds`;
+  проще и дешевле, но на границе окон возможен двойной всплеск.
+"""
+
+import time
+from abc import ABC, abstractmethod
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Callable
+
+from redis.asyncio import Redis
+
+if TYPE_CHECKING:
+    from app.config import Settings
+
+
+@dataclass(frozen=True)
+class RateLimitResult:
+    allowed: bool
+    limit: int
+    remaining: int
+    # Через сколько секунд имеет смысл повторить запрос (0, если allowed).
+    retry_after: float
+
+
+class RateLimiter(ABC):
+    @abstractmethod
+    async def check(self, key: str) -> RateLimitResult:
+        """Пытается «потратить» один запрос для ключа (например, IP клиента)."""
+
+
+# KEYS[1] — ключ ведра (hash: tokens, ts)
+# ARGV: capacity, refill_per_second, now (секунды, float), ttl (секунды)
+_TOKEN_BUCKET_LUA = """
+local capacity = tonumber(ARGV[1])
+local rate = tonumber(ARGV[2])
+local now = tonumber(ARGV[3])
+local ttl = tonumber(ARGV[4])
+
+local data = redis.call('HMGET', KEYS[1], 'tokens', 'ts')
+local tokens = tonumber(data[1])
+local ts = tonumber(data[2])
+if tokens == nil then
+  tokens = capacity
+  ts = now
+end
+
+local elapsed = math.max(0, now - ts)
+tokens = math.min(capacity, tokens + elapsed * rate)
+
+local allowed = 0
+local retry_after = 0
+if tokens >= 1 then
+  tokens = tokens - 1
+  allowed = 1
+else
+  retry_after = (1 - tokens) / rate
+end
+
+redis.call('HSET', KEYS[1], 'tokens', tostring(tokens), 'ts', tostring(now))
+redis.call('EXPIRE', KEYS[1], ttl)
+return {allowed, tostring(tokens), tostring(retry_after)}
+"""
+
+# KEYS[1] — счётчик окна; ARGV: window_seconds
+# Окно открывается первым запросом: INCR создаёт ключ, затем ставим TTL.
+_FIXED_WINDOW_LUA = """
+local count = redis.call('INCR', KEYS[1])
+if count == 1 then
+  redis.call('EXPIRE', KEYS[1], tonumber(ARGV[1]))
+end
+local ttl = redis.call('TTL', KEYS[1])
+if ttl < 0 then
+  redis.call('EXPIRE', KEYS[1], tonumber(ARGV[1]))
+  ttl = tonumber(ARGV[1])
+end
+return {count, ttl}
+"""
+
+
+class TokenBucketRateLimiter(RateLimiter):
+    def __init__(
+        self,
+        redis: Redis,
+        capacity: int,
+        refill_per_second: float,
+        prefix: str = "rl:tb:",
+        clock: Callable[[], float] = time.time,
+    ) -> None:
+        if capacity < 1 or refill_per_second <= 0:
+            raise ValueError("capacity must be >= 1 and refill_per_second > 0")
+        self._redis = redis
+        self.capacity = capacity
+        self.refill_per_second = refill_per_second
+        self._prefix = prefix
+        self._clock = clock
+        self._script = redis.register_script(_TOKEN_BUCKET_LUA)
+        # Ведро полностью пополняется за capacity / rate секунд; после этого
+        # состояние эквивалентно «ключа нет», так что ключ можно удалить.
+        self._ttl = max(1, int(capacity / refill_per_second) + 1)
+
+    async def check(self, key: str) -> RateLimitResult:
+        allowed, tokens, retry_after = await self._script(
+            keys=[self._prefix + key],
+            args=[self.capacity, self.refill_per_second, self._clock(), self._ttl],
+        )
+        return RateLimitResult(
+            allowed=bool(int(allowed)),
+            limit=self.capacity,
+            remaining=int(float(tokens)),
+            retry_after=float(retry_after),
+        )
+
+
+class FixedWindowRateLimiter(RateLimiter):
+    def __init__(
+        self,
+        redis: Redis,
+        limit: int,
+        window_seconds: int,
+        prefix: str = "rl:fw:",
+        clock: Callable[[], float] = time.time,
+    ) -> None:
+        if limit < 1 or window_seconds < 1:
+            raise ValueError("limit and window_seconds must be >= 1")
+        self._redis = redis
+        self.limit = limit
+        self.window_seconds = window_seconds
+        self._prefix = prefix
+        self._clock = clock
+        self._script = redis.register_script(_FIXED_WINDOW_LUA)
+
+    async def check(self, key: str) -> RateLimitResult:
+        # Номер окна в ключе: смена окна = новый счётчик, старый истечёт по TTL.
+        window = int(self._clock() // self.window_seconds)
+        count, ttl = await self._script(
+            keys=[f"{self._prefix}{key}:{window}"],
+            args=[self.window_seconds],
+        )
+        count, ttl = int(count), int(ttl)
+        allowed = count <= self.limit
+        return RateLimitResult(
+            allowed=allowed,
+            limit=self.limit,
+            remaining=max(0, self.limit - count),
+            retry_after=0.0 if allowed else float(max(ttl, 1)),
+        )
+
+
+def build_rate_limiter(settings: "Settings", redis: Redis) -> RateLimiter:
+    """Выбирает алгоритм по настройке; по умолчанию token bucket."""
+    if settings.rate_limit_algorithm == "fixed_window":
+        return FixedWindowRateLimiter(
+            redis,
+            limit=settings.rate_limit_window_limit,
+            window_seconds=settings.rate_limit_window_seconds,
+        )
+    return TokenBucketRateLimiter(
+        redis,
+        capacity=settings.rate_limit_bucket_capacity,
+        refill_per_second=settings.rate_limit_refill_per_second,
+    )
diff --git a/app/resilience/retry.py b/app/resilience/retry.py
new file mode 100644
index 0000000..2b03e0d
--- /dev/null
+++ b/app/resilience/retry.py
@@ -0,0 +1,77 @@
+"""Retry: повтор вызова при временных (transient) сбоях.
+
+Ключевые правила, которые здесь соблюдены:
+* повторяем только ошибки, которые могут пройти сами (retry_on / is_retryable);
+* число попыток ограничено;
+* пауза растёт экспоненциально и «размазывается» случайным jitter-ом, чтобы
+  клиенты не били в зависимость синхронно (retry storm);
+* повторы не выходят за общий дедлайн запроса.
+"""
+
+import asyncio
+import logging
+import random
+from typing import Awaitable, Callable, TypeVar
+
+from app.resilience.deadline import DeadlineExceededError, remaining_time
+
+logger = logging.getLogger(__name__)
+
+T = TypeVar("T")
+
+
+def backoff_delay(attempt: int, base: float, cap: float) -> float:
+    """Exponential backoff с full jitter: random(0, min(cap, base * 2**attempt))."""
+    return random.uniform(0.0, min(cap, base * (2**attempt)))
+
+
+async def retry_async(
+    func: Callable[[], Awaitable[T]],
+    *,
+    max_attempts: int = 3,
+    base_delay: float = 0.1,
+    max_delay: float = 2.0,
+    retry_on: tuple[type[BaseException], ...] = (Exception,),
+    is_retryable: Callable[[BaseException], bool] | None = None,
+    sleep: Callable[[float], Awaitable[None]] = asyncio.sleep,
+) -> T:
+    """Вызывает func до max_attempts раз.
+
+    Не повторяет ошибки вне retry_on или те, для которых is_retryable вернул
+    False, а также любые DeadlineExceededError. Если до дедлайна остаётся
+    меньше, чем нужно на паузу, повторять нет смысла: пробрасываем последнюю
+    ошибку сразу.
+    """
+    if max_attempts < 1:
+        raise ValueError("max_attempts must be >= 1")
+
+    last_exc: BaseException | None = None
+    for attempt in range(max_attempts):
+        try:
+            return await func()
+        except DeadlineExceededError:
+            raise
+        except retry_on as exc:
+            if is_retryable is not None and not is_retryable(exc):
+                raise
+            last_exc = exc
+            if attempt == max_attempts - 1:
+                break
+
+            delay = backoff_delay(attempt, base_delay, max_delay)
+            budget = remaining_time()
+            if budget is not None and budget <= delay:
+                logger.warning("retry: not enough deadline budget left, giving up")
+                break
+
+            logger.warning(
+                "retry: attempt %d/%d failed (%r), sleeping %.3fs",
+                attempt + 1,
+                max_attempts,
+                exc,
+                delay,
+            )
+            await sleep(delay)
+
+    assert last_exc is not None
+    raise last_exc
